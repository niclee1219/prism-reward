# --- Frontend (build-time, set in Cloudflare Pages) ---
# Base URL of the Supabase Edge Functions.
VITE_API_BASE=https://YOUR-PROJECT.supabase.co/functions/v1
# Supabase anon (publishable) key. Safe to ship: every table is locked by Row Level Security.
VITE_SUPABASE_ANON_KEY=
# Public URL of the game, shown as the QR code on /board. Defaults to the site origin.
VITE_GAME_URL=

# --- Edge Functions (set with `supabase secrets set`, never in the frontend) ---
# ADMIN_PIN=choose-a-6-digit-pin
